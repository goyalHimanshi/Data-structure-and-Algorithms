class Solution {
public:
    int countPermutations(vector<int>& nums) {
        //we have to firstly find that is the first element in the array is smaller and unique 
        int n=nums.size();
        const int MOD=1e9+7;
        for(int i=1;i<n;i++){
            if(nums[i]<=nums[0]){
                return 0;
                //answer is not possible ,we cant unlock the computers
            }
        }
        //now you have to only reture the factorial of n-1 if you find the min and unique no. nums[0]
        long long ans=1;
        for(int i=1;i<=n-1;i++){
            ans=(ans*i)%MOD;
        }
        return (int)ans;
        
    }
};
