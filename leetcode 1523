class Solution {
public:
    int countOdds(int low, int high) {
        if(low%2==0 && high%2==0){
            //even-even
            return (high-low)/2;
        }else if((low%2!=0 && high%2==0) ||(low%2==0 && high%2!=0)){
            //odd-even
            return (high-low+1)/2; 
        }else
            //odd-odd
             return (high-low+2)/2; 
        
        
    }
};
