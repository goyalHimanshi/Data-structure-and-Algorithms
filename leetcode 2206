//approackh 2 using set 
//in set we store the element if it is not in the set and again if we find the same existing elemenent then we erase from the set and at the end if we find that the set is empty then  we get to know that yes the pair of the given element in an array exists 
set<int>st;
for(auto &it:nums){
    if(st.count(it)){
        st.erase(it);
    }else{
        st.insert(it);
    }
}
return st.empty();

